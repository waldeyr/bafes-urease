# ==============================================================================
# PT-BR: Copie este arquivo para .env e preencha os valores.
#        O run.sh carrega o .env automaticamente e repassa as variaveis ao container.
#        O .env esta no .gitignore — NUNCA versione sua chave.
# EN-US: Copy this file to .env and fill in the values.
#        run.sh loads .env automatically and forwards the variables into the container.
#        .env is in .gitignore — NEVER commit your key.
#
#   cp .env.example .env
# ==============================================================================

# PT-BR: Chave da API do NCBI. Eleva o limite do E-utilities de 3 para 10 req/s,
#        o que reduz muito os HTTP 429 ao verificar e baixar os 10 genomas.
#        Gere em: https://account.ncbi.nlm.nih.gov/ -> Account Settings -> API Key Management
# EN-US: NCBI API key. Raises the E-utilities limit from 3 to 10 req/s, which greatly
#        reduces HTTP 429 errors when verifying and downloading the 10 genomes.
#        Generate at: https://account.ncbi.nlm.nih.gov/ -> Account Settings -> API Key Management
NCBI_API_KEY=

# PT-BR: E-mail de contato. A politica do NCBI E-utilities exige identificacao do
#        cliente; sem ele o NCBI pode limitar ou bloquear requisicoes em volume.
# EN-US: Contact e-mail. NCBI E-utilities policy requires client identification;
#        without it NCBI may throttle or block requests at volume.
NCBI_EMAIL=

# PT-BR: Defina como 1 APENAS em redes com proxy TLS interceptador, onde a verificacao
#        de certificado falha por causa da infraestrutura. Desliga a validacao TLS.
# EN-US: Set to 1 ONLY on networks behind a TLS-intercepting proxy, where certificate
#        verification fails because of the infrastructure. Disables TLS validation.
BAFES_INSECURE_SSL=
