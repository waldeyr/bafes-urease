/*
========================================================================================
   Nextflow Configuration File for BAFES-urease-mining
========================================================================================
*/

params {
    accessions      = "data/accessions.tsv"
    references      = "data/urease_references.fasta"
    pfam_hmm        = "Pfam-A.hmm"
    bakta_db        = "db/db"
    outdir          = "results"
    container_image = "bafes-urease"

    // PT-BR: Inclui as sequências de ureC curadas de `references` na árvore, como contexto
    //        filogenético. Desligar restringe a árvore aos UreC das estirpes.
    // EN-US: Includes the curated ureC sequences from `references` in the tree, as
    //        phylogenetic context. Turning it off limits the tree to the strains' UreC.
    phylo_include_refs = true

    // PT-BR: Genes flanqueadores de cada lado do locus de urease no recorte para a sintenia.
    // EN-US: Flanking genes on each side of the urease locus in the synteny slice.
    synteny_flank_genes = 5

    // PT-BR: Ancorar o recorte em TODO candidato, inclusive domínios promíscuos (cobW,
    //        CT_C_D). Desligado por padrão — eles geram regiões fora de qualquer operon.
    // EN-US: Anchor the slice on EVERY candidate, promiscuous domains included (cobW,
    //        CT_C_D). Off by default — they produce regions outside any operon.
    synteny_all_candidates = false
}

profiles {
    /*
       PT-BR: standard — usado quando o Nextflow JÁ roda dentro do container (fluxo do run.sh).
       EN-US: standard — used when Nextflow is ALREADY running inside the container (run.sh flow).
    */
    standard {
        process.executor = 'local'
    }
    /*
       PT-BR: docker — Nextflow no host, um container por processo.
       EN-US: docker — Nextflow on the host, one container per process.
    */
    docker {
        process.executor  = 'local'
        process.container = params.container_image
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        process.executor       = 'local'
        process.container      = params.container_image
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    conda {
        process.executor = 'local'
        conda.enabled    = true
        process.conda    = "$projectDir/environment.yml"
    }
}

manifest {
    name            = 'BAFES-urease-mining'
    author          = 'CBAFES UnB Team'
    description     = 'Pipeline para mineração de genes de urease, transporte de ureia e rotas alternativas de catabolismo'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.3'
}

/*
   PT-BR: Padrão para processos não listados. Os overrides abaixo estão dimensionados
          para um host de 96 núcleos: o executor local limita a concorrência pela soma
          de `cpus`, então 10 estirpes x 9 núcleos (90 <= 96) atravessam o gargalo do
          hmmscan em uma única onda, em vez de três ondas de 4 tarefas com 24 núcleos.
          O hmmscan escala sublinearmente com threads — mais tarefas em paralelo com
          menos threads cada rende mais throughput que o inverso.
   EN-US: Default for processes not listed below. The overrides are sized for a
          96-core host: the local executor caps concurrency by the sum of `cpus`, so
          10 strains x 9 cores (90 <= 96) clear the hmmscan bottleneck in a single wave
          instead of three waves of 4 tasks at 24 cores. hmmscan scales sublinearly
          with threads — more parallel tasks with fewer threads each yields more
          throughput than the reverse.
*/
process {
    cpus   = 24
    memory = '96 GB'
    time   = '96h'

    // PT-BR: Limitado por rede, não por CPU / EN-US: Network-bound, not CPU-bound
    withName: DOWNLOAD_GENOME    { cpus = 2;  memory = '8 GB';  time = '4h'  }
    withName: QC_QUAST           { cpus = 4;  memory = '16 GB'; time = '4h'  }
    withName: QC_CHECKM2         { cpus = 8;  memory = '64 GB'; time = '8h'  }
    withName: BAKTA_ANNOTATE     { cpus = 9;  memory = '64 GB'; time = '24h' }
    // PT-BR: Gargalo — hmmscan contra o Pfam completo / EN-US: Bottleneck — hmmscan against full Pfam
    withName: EXTRACT_CANDIDATES { cpus = 9;  memory = '32 GB'               }
    withName: MERGE_ALL_STRAINS  { cpus = 2;  memory = '8 GB';  time = '2h'  }
    withName: EXTRACT_LOCUS      { cpus = 1;  memory = '8 GB';  time = '1h'  }
    /*
       PT-BR: ATENÇÃO — o executor `local` NÃO ignora `time`; ele mata a tarefa quando o
              limite estoura. E, ao matar, o Nextflow chama `process.exitValue()` logo
              depois de `destroy()`, antes do processo ser recolhido: isso lança
              `IllegalThreadStateException: process hasn't exited`, que SUBSTITUI a mensagem
              real "Process exceeded running time limit". Ou seja: um `time` estourado aqui
              aparece no log como um erro genérico e enganoso, não como um timeout.
              (LocalTaskHandler.checkIfCompleted, Nextflow 26.04.6 — visto de verdade em
              .logs/exec-20260728-143927.log, ANALYZE_SYNTENY, exit 143 = SIGTERM.)
              Antes do recorte de locus o clinker recebia os 10 genomas inteiros (~46.500
              CDS, ~10^9 alinhamentos par-a-par) e não terminava em 8 h. Com o recorte são
              algumas dezenas de genes por estirpe e a etapa roda em segundos; as 8 h ficam
              como teto folgado.
       EN-US: WARNING — the `local` executor does NOT ignore `time`; it kills the task when
              the limit is exceeded. And when killing, Nextflow calls `process.exitValue()`
              right after `destroy()`, before the process is reaped: that throws
              `IllegalThreadStateException: process hasn't exited`, which REPLACES the real
              "Process exceeded running time limit" message. So a blown `time` shows up in
              the log as a generic, misleading error rather than as a timeout.
              (LocalTaskHandler.checkIfCompleted, Nextflow 26.04.6 — actually observed in
              .logs/exec-20260728-143927.log, ANALYZE_SYNTENY, exit 143 = SIGTERM.)
              Before the locus slice, clinker got all 10 whole genomes (~46,500 CDS, ~10^9
              pairwise alignments) and did not finish within 8 h. With the slice it is a few
              dozen genes per strain and the step runs in seconds; the 8 h stay as ample headroom.
    */
    withName: ANALYZE_SYNTENY    { cpus = 8;  memory = '32 GB'; time = '8h'  }
    withName: BUILD_PHYLOGENY    { cpus = 16; memory = '32 GB'; time = '24h' }
}

/*
   PT-BR: overwrite = true evita o aborto "file already exists" na segunda execução.
   EN-US: overwrite = true avoids the "file already exists" abort on a second run.
*/
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/nf_report.html"
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/nf_trace.txt"
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/nf_timeline.html"
}

dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/nf_dag.html"
}
